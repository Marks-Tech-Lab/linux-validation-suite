{
  "profile_name": "ARM64 Native CPU Scalar",
  "profile_type": "validation_schedule",
  "segment_label_source": "ARM64 Native CPU Scalar_info.txt",
  "menu_description": "ARM64 lab validation of the shared native CPU helper scalar kernel",
  "menu_group": "advanced",
  "defaults": {
    "telemetry_interval_seconds": 1.0,
    "trim_start_seconds": 10,
    "trim_end_seconds": 10
  },
  "stages": [
    {
      "id": "arm64_native_cpu_scalar",
      "name": "CPU",
      "duration_seconds": 120,
      "enabled": true,
      "modules": {
        "cpu": {
          "enabled": true,
          "backend_preference": "native",
          "mode": "normal",
          "load": "steady",
          "instruction_set": "scalar",
          "threads": "all",
          "priority": "normal",
          "dataset": "large"
        }
      },
      "normalization": {
        "trim_start_seconds": 10,
        "trim_end_seconds": 10
      }
    }
  ]
}
