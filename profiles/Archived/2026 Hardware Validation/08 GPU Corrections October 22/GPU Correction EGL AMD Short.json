{
  "profile_name": "GPU Correction EGL AMD Short",
  "menu_group": "advanced",
  "menu_description": "Targeted texture readback; verify current PCI mapping before launch",
  "require_all_stages_runnable": true,
  "defaults": {"telemetry_interval_seconds": 2.0, "trim_start_seconds": 5, "trim_end_seconds": 5},
  "stages": [{
    "id": "egl_texture_readback", "name": "VRAM", "display_label": "EGL AMD Texture Readback",
    "duration_seconds": 90, "enabled": true,
    "modules": {
      "cpu": {"enabled": false, "power_auto": false},
      "memory": {"enabled": false},
      "gpu_3d": {"enabled": false},
      "vram": {"enabled": true, "allocation_percent": 1, "gpus": "slots:0000:0d:00.0", "backend_preference": "egl", "priority": "normal"},
      "storage_benchmark": {"enabled": false}
    },
    "normalization": {"trim_start_seconds": 5, "trim_end_seconds": 5},
    "analysis": {"intent": "functional"}
  }]
}
