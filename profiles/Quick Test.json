{
  "profile_name": "Quick Test",
  "profile_type": "validation_schedule",
  "menu_group": "quick",
  "defaults": {
    "telemetry_interval_seconds": 2.0,
    "trim_start_seconds": 30,
    "trim_end_seconds": 30,
    "strict_threshold_recommendation_warnings": null
  },
  "stages": [
    {
      "id": "segment_1",
      "name": "Combined",
      "duration_seconds": 90,
      "enabled": true,
      "modules": {
        "cpu": {
          "enabled": true,
          "mode": "extreme",
          "load": "steady",
          "power_auto": true,
          "instruction_set": "auto",
          "threads": "all",
          "priority": "high",
          "dataset": "large"
        },
        "memory": {
          "enabled": false,
          "allocation_percent": 80,
          "instruction_set": "auto",
          "priority": "normal",
          "threads": "all"
        },
        "gpu_3d": {
          "enabled": true,
          "mode": "steady",
          "intensity": "extreme",
          "gpus": "discrete_all",
          "allocation_percent": 0,
          "priority": "normal",
          "backend_preference": "auto",
          "compute_variant": "stress_hash"
        },
        "vram": {
          "enabled": false,
          "allocation_percent": 80,
          "gpus": "all",
          "priority": "normal",
          "backend_preference": "auto"
        }
      },
      "normalization": {
        "trim_start_seconds": 30,
        "trim_end_seconds": 30
      },
      "strict_threshold_recommendation_warnings": null,
      "display_label": "Power (CPU + GPU)"
    },
    {
      "id": "segment_2",
      "name": "Combined",
      "duration_seconds": 90,
      "enabled": true,
      "modules": {
        "cpu": {
          "enabled": true,
          "mode": "extreme",
          "load": "steady",
          "instruction_set": "auto",
          "instruction_intent": "baseline_vector",
          "threads": "all",
          "priority": "high",
          "dataset": "large"
        },
        "memory": {
          "enabled": false,
          "allocation_percent": 80,
          "instruction_set": "auto",
          "priority": "normal",
          "threads": "all"
        },
        "gpu_3d": {
          "enabled": false,
          "mode": "steady",
          "intensity": "extreme",
          "gpus": "all",
          "allocation_percent": 0,
          "priority": "normal",
          "backend_preference": "auto",
          "compute_variant": "stress_hash"
        },
        "vram": {
          "enabled": true,
          "allocation_percent": 90,
          "gpus": "all",
          "priority": "normal",
          "backend_preference": "auto"
        }
      },
      "normalization": {
        "trim_start_seconds": 30,
        "trim_end_seconds": 30
      },
      "strict_threshold_recommendation_warnings": null,
      "display_label": "Baseline SIMD (CPU + VRAM)"
    },
    {
      "id": "segment_3",
      "name": "Combined",
      "duration_seconds": 90,
      "enabled": true,
      "modules": {
        "cpu": {
          "enabled": true,
          "mode": "extreme",
          "load": "steady",
          "instruction_set": "auto",
          "instruction_intent": "highest_verified_vector",
          "threads": "all",
          "priority": "high",
          "dataset": "large"
        },
        "memory": {
          "enabled": true,
          "allocation_percent": 90,
          "instruction_set": "auto",
          "priority": "normal",
          "threads": "all"
        },
        "gpu_3d": {
          "enabled": false,
          "mode": "steady",
          "intensity": "extreme",
          "gpus": "all",
          "allocation_percent": 0,
          "priority": "normal",
          "backend_preference": "auto",
          "compute_variant": "stress_hash"
        },
        "vram": {
          "enabled": false,
          "allocation_percent": 80,
          "gpus": "all",
          "priority": "normal",
          "backend_preference": "auto"
        }
      },
      "normalization": {
        "trim_start_seconds": 30,
        "trim_end_seconds": 30
      },
      "strict_threshold_recommendation_warnings": null,
      "display_label": "High-Throughput SIMD (CPU + RAM)"
    },
    {
      "id": "segment_4",
      "name": "Combined",
      "duration_seconds": 90,
      "enabled": true,
      "modules": {
        "cpu": {
          "enabled": false,
          "mode": "normal",
          "load": "steady",
          "instruction_set": "auto",
          "threads": "all",
          "priority": "normal",
          "dataset": "large"
        },
        "memory": {
          "enabled": false,
          "allocation_percent": 80,
          "instruction_set": "auto",
          "priority": "normal",
          "threads": "all"
        },
        "gpu_3d": {
          "enabled": true,
          "mode": "steady",
          "intensity": "extreme",
          "gpus": "all",
          "allocation_percent": 0,
          "priority": "normal",
          "backend_preference": "auto",
          "compute_variant": "stress_hash"
        },
        "vram": {
          "enabled": true,
          "allocation_percent": 90,
          "gpus": "all",
          "priority": "normal",
          "backend_preference": "auto"
        }
      },
      "normalization": {
        "trim_start_seconds": 30,
        "trim_end_seconds": 30
      },
      "strict_threshold_recommendation_warnings": null,
      "display_label": "GPU (3D + VRAM)"
    },
    {
      "id": "storage_benchmark_1",
      "name": "Storage Benchmark",
      "duration_seconds": null,
      "enabled": true,
      "modules": {
        "storage_benchmark": {
          "enabled": true,
          "profile_id": "storage_kdiskmark_cdm_style_v1",
          "target_mode": "all_internal",
          "target_path": "",
          "drive_execution": "sequential",
          "test_size_gib": 1,
          "runs": 1,
          "allow_system_drive": true
        }
      },
      "normalization": {
        "trim_start_seconds": 30,
        "trim_end_seconds": 30
      },
      "strict_threshold_recommendation_warnings": null,
      "display_label": "Storage Benchmark"
    }
  ]
}
